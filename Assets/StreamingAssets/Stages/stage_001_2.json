    "tutorialSteps": [
        {
            "type": "line",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Despair30",
            "text": "안쪽 방에 셋이 더 있습니다. 이번에 쓸 수 있는 건 단검 대원 하나뿐이에요."
        },
        {
            "type": "enemyLines"
        },
        {
            "type": "line",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Despair30",
            "text": "적의 사선을 켜 두었습니다. 두 사수는 서로를 마주 보고 있죠. 가장 가까운 상대가 같은 편이라 지금은 둘 다 쏘지 않습니다."
        },
        {
            "type": "place",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Despair30",
            "text": "두 사수 사이, 표시된 칸에 배치하세요. 가이드처럼 안쪽 적을 바라보게 돌린 뒤 클릭하면 됩니다.",
            "selectText": "단검 대원을 고르세요.",
            "pieceType": 1,
            "cellIndex": 14,
            "facing": 0
        },
        {
            "type": "line",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Despair30",
            "text": "보이시죠? 단검 대원이 끼어들자 두 사수가 모두 그를 겨눕니다. 적은 작전이 시작되는 순간 표적을 정합니다."
        },
        {
            "type": "line",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Despair30",
            "text": "하지만 단검이 권총보다 먼저 움직입니다. 대원이 적을 베고 자리를 비우면, 총알은 빈자리를 지나 서로에게 날아가죠."
        },
        {
            "type": "line",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Despair30",
            "text": "이게 오인사격입니다. 총알은 적과 아군을 가리지 않아요. 우리 대원을 사선 위에 세울 때도 늘 기억하셔야 합니다."
        },
        {
            "type": "start",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Despair30",
            "text": "시작 버튼(Space)을 눌러 직접 확인해 보세요.",
            "id": "start"
        },
        {
            "type": "result",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Despair30",
            "text": "",
            "calloutText": "오인사격! 적 사수들이 서로를 쐈습니다."
        },
        {
            "type": "line",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Joy",
            "text": "대원 하나로 적 셋을 정리했군요. 이 감각을 잊지 마세요, 대장.",
            "condition": "win"
        },
        {
            "type": "waitRetry",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Joy",
            "text": "확정을 누르면 다음 작전으로 이어집니다.",
            "condition": "win",
            "gotoId": "start"
        },
        {
            "type": "line",
            "speaker": "부관 엘리자",
            "character": "Eliza_Resistance_Sad",
            "text": "적이 남았습니다. 사수들의 사선을 다시 확인해 보죠.",
            "condition": "fail"
